<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Sentinel mark: a guardian's shield carrying a performance gauge whose needle sits high in the range.
        Drawn on a 64×64 grid. This dictionary is the single source for the sidebar, loading screen and the
        generated Assets/Sentinel.ico, so keep it free of anything that needs the app's other resources.
    -->

    <LinearGradientBrush x:Key="LogoFill" StartPoint="0.1,0" EndPoint="0.9,1">
        <GradientStop Color="#9B6BFF" Offset="0" />
        <GradientStop Color="#6D5BFF" Offset="0.45" />
        <GradientStop Color="#22D3EE" Offset="1" />
    </LinearGradientBrush>

    <PathGeometry x:Key="LogoShield"
                  Figures="M 32,3 C 39,6.2 46.5,8.2 55,9 L 55,29 C 55,44.5 45.5,55 32,61 C 18.5,55 9,44.5 9,29 L 9,9 C 17.5,8.2 25,6.2 32,3 Z" />

    <DrawingGroup x:Key="LogoDrawing">
        <!-- Fixed 64×64 bounds so every rendering of the mark has identical padding. -->
        <GeometryDrawing Brush="Transparent" Geometry="M 0,0 H 64 V 64 H 0 Z" />

        <GeometryDrawing Brush="{StaticResource LogoFill}" Geometry="{StaticResource LogoShield}" />

        <!-- Gloss on the upper half, clipped to the shield. -->
        <DrawingGroup ClipGeometry="{StaticResource LogoShield}">
            <GeometryDrawing Geometry="M 0,0 H 64 V 30 H 0 Z">
                <GeometryDrawing.Brush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#40FFFFFF" Offset="0" />
                        <GradientStop Color="#00FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </GeometryDrawing.Brush>
            </GeometryDrawing>
        </DrawingGroup>

        <!-- Inner rim for depth. -->
        <GeometryDrawing Geometry="M 32,8.5 C 37.8,11.1 44,12.8 50.5,13.5 L 50.5,29.3 C 50.5,41.6 43,50.2 32,55.2 C 21,50.2 13.5,41.6 13.5,29.3 L 13.5,13.5 C 20,12.8 26.2,11.1 32,8.5 Z">
            <GeometryDrawing.Pen>
                <Pen Brush="#2EFFFFFF" Thickness="1.2" />
            </GeometryDrawing.Pen>
        </GeometryDrawing>

        <!-- Gauge track (240°) and the filled part up to the needle. Centre 32,31, radius 13. -->
        <GeometryDrawing Geometry="M 20.74,37.5 A 13,13 0 1 1 43.26,37.5">
            <GeometryDrawing.Pen>
                <Pen Brush="#59FFFFFF" Thickness="4.2" StartLineCap="Round" EndLineCap="Round" />
            </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M 20.74,37.5 A 13,13 0 0 1 41.19,21.81">
            <GeometryDrawing.Pen>
                <Pen Brush="White" Thickness="4.2" StartLineCap="Round" EndLineCap="Round" />
            </GeometryDrawing.Pen>
        </GeometryDrawing>

        <!-- Needle and hub. -->
        <GeometryDrawing Brush="White" Geometry="M 30.44,29.44 L 39.43,23.57 L 33.56,32.56 Z" />
        <GeometryDrawing Brush="White" Geometry="M 35.6,31 A 3.6,3.6 0 1 1 28.4,31 A 3.6,3.6 0 1 1 35.6,31 Z" />
        <GeometryDrawing Brush="#5B4BFF" Geometry="M 33.4,31 A 1.4,1.4 0 1 1 30.6,31 A 1.4,1.4 0 1 1 33.4,31 Z" />
    </DrawingGroup>

    <DrawingImage x:Key="LogoImage" Drawing="{StaticResource LogoDrawing}" />
</ResourceDictionary>

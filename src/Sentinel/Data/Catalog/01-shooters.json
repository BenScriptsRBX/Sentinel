  {"n": "Borderlands 4", "s": [1285190], "e": "Unreal 5", "g": "Looter Shooter", "gpu": 9, "cpu": 7, "y": 2025, "f": ["dlss", "fg", "mfg", "fsr", "afg", "xess", "tsr", "reflex", "rt", "hdr"], "t": "Very heavy UE5 title: Lumen + Nanite. Start from the Medium preset, upscaler Quality, and consider frame gen."},

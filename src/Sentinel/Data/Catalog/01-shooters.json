  {"n": "Warhammer 40,000: Space Marine 2", "s": [2183900], "e": "Swarm", "g": "Action Shooter", "gpu": 7, "cpu": 8, "y": 2024, "f": ["dlss", "fg", "fsr", "afg", "xess", "hdr"], "t": "Swarm hordes are CPU bound; frame gen is the best lever on mid CPUs.", "r": 136},

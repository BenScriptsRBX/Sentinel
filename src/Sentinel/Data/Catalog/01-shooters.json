[
  {"n": "Counter-Strike 2", "a": ["CS2", "Counter-Strike Global Offensive"], "s": [730], "x": ["cs2.exe"], "e": "Source 2", "g": "Tactical FPS", "gpu": 3, "cpu": 3, "c": true, "y": 2023, "cfg": "cs2", "f": ["reflex", "al2", "fsr"], "t": "Reflex 'Enabled + Boost' and Boost Player Contrast on. Keep MSAA 4x — CMAA2 blurs distant heads. Avoid FSR 1 here; it softens the image a lot.", "r": 1},
  {"n": "Valorant", "l": ["Riot", "Riot Client"], "x": ["VALORANT-Win64-Shipping.exe"], "e": "Unreal 5", "g": "Tactical FPS", "gpu": 1, "cpu": 2, "c": true, "y": 2020, "f": ["reflex", "al2"], "t": "Riot Vanguard requires TPM/Secure Boot. Reflex 'On + Boost'. Turn off Vignette, Bloom, Distortion and Cast Shadows to cut clutter. Multithreaded rendering on."},
  {"n": "Apex Legends", "s": [1172470], "x": ["r5apex.exe", "r5apex_dx12.exe"], "e": "Source (Respawn)", "g": "Battle Royale", "gpu": 4, "cpu": 5, "c": true, "y": 2019, "cfg": "apex", "f": ["reflex", "dx12", "hdr"], "t": "Try the DX12 client (-eac_launcher_settings SettingsDX12.json). Reflex 'Enabled + Boost'. Adaptive resolution FPS target 0, Model detail Low improves 1% lows.", "r": 2},
  {"n": "Fortnite", "l": ["Epic", "Epic Games"], "x": ["FortniteClient-Win64-Shipping.exe"], "e": "Unreal 5", "g": "Battle Royale", "gpu": 5, "cpu": 5, "c": true, "y": 2017, "cfg": "ue:FortniteGame", "f": ["dlss", "fsr", "tsr", "xess", "reflex", "al2", "rt", "dx12", "dx11", "hdr"], "t": "Competitive: Performance mode (DX11-based renderer) with 3D resolution 100% and View Distance Epic. Showcase: DX12, Lumen + Nanite with DLSS/TSR Quality."},
  {"n": "Call of Duty", "a": ["Call of Duty HQ", "Call of Duty Black Ops 6", "Call of Duty Warzone", "Call of Duty Modern Warfare III", "Call of Duty Black Ops 7"], "s": [1938090, 2933620], "x": ["cod.exe", "BlackOps6.exe"], "e": "IW Engine", "g": "FPS", "gpu": 6, "cpu": 6, "c": true, "y": 2024, "f": ["dlss", "fg", "mfg", "fsr", "afg", "xess", "reflex", "al2", "hdr"], "t": "Set VRAM Scale Target to 80-90%. On-demand texture streaming off for stable frametimes. Reflex 'On + Boost'. Frame gen adds latency — keep it off in multiplayer.", "r": 6},
  {"n": "Call of Duty: Modern Warfare II", "s": [1962660], "e": "IW Engine", "g": "FPS", "gpu": 6, "cpu": 6, "c": true, "y": 2022, "f": ["dlss", "fsr", "xess", "reflex", "hdr"], "t": "Shader preload once after each driver update. Lower 'Particle Quality' and 'Bullet Impacts' for the cleanest image in fights."},
  {"n": "Battlefield 6", "s": [2807960], "e": "Frostbite", "g": "FPS", "gpu": 7, "cpu": 8, "c": true, "y": 2025, "f": ["dlss", "fg", "mfg", "fsr", "afg", "xess", "reflex", "al2", "hdr"], "t": "Very CPU heavy on 64-player maps — 6+ fast cores recommended. Terrain/Mesh quality affect CPU; Effects/Volumetrics affect GPU. Future Frame Rendering on."},
  {"n": "Battlefield 2042", "s": [1517290], "e": "Frostbite", "g": "FPS", "gpu": 7, "cpu": 9, "c": true, "y": 2021, "f": ["dlss", "fsr", "xess", "reflex", "rt", "hdr"], "t": "Strongly CPU bound with 128 players. Future Frame Rendering on, DX12 on, Ray-traced AO off.", "r": 59},
  {"n": "Battlefield V", "s": [1238810], "e": "Frostbite", "g": "FPS", "gpu": 6, "cpu": 6, "c": true, "y": 2018, "f": ["dlss", "rt", "dx12", "dx11", "hdr"], "t": "DX11 often has better frametimes than DX12 unless you use DXR. Future Frame Rendering on.", "r": 94},
  {"n": "Battlefield 1", "s": [1238840], "e": "Frostbite", "g": "FPS", "gpu": 5, "cpu": 6, "c": true, "y": 2016, "f": ["dx11", "dx12", "hdr"], "t": "Use DX11; the DX12 path stutters. Future Frame Rendering on.", "r": 229},
  {"n": "Battlefield 4", "s": [1238860], "e": "Frostbite", "g": "FPS", "gpu": 3, "cpu": 5, "c": true, "y": 2013, "f": ["dx11"], "t": "Mantle is gone on modern GPUs — use DX11. Resolution scale above 100% is a cheap AA on fast cards.", "r": 741},
  {"n": "Overwatch 2", "a": ["Overwatch"], "s": [2357570], "x": ["Overwatch.exe"], "e": "Proprietary", "g": "Hero Shooter", "gpu": 3, "cpu": 4, "c": true, "y": 2022, "f": ["reflex", "al2", "fsr", "hdr"], "t": "Reflex 'Enabled + Boost'. Render scale 100% (Custom). Dynamic reflections and Local fog detail off for clarity. Avoid 'Reduce Buffering' together with Reflex."},
  {"n": "Marvel Rivals", "s": [2767030], "x": ["Marvel-Win64-Shipping.exe"], "e": "Unreal 5", "g": "Hero Shooter", "gpu": 7, "cpu": 6, "c": true, "y": 2024, "cfg": "ue:Marvel", "f": ["dlss", "fg", "fsr", "afg", "xess", "tsr", "reflex", "al2", "hdr"], "t": "Global Illumination Low (Lumen off) is the biggest win. Reflex Boost on, frame gen off for ranked."},
  {"n": "Rainbow Six Siege", "a": ["Tom Clancy's Rainbow Six Siege", "Rainbow Six Siege X"], "s": [359550], "x": ["RainbowSix.exe", "RainbowSix_Vulkan.exe", "RainbowSix_DX12.exe"], "e": "Anvil", "g": "Tactical FPS", "gpu": 3, "cpu": 4, "c": true, "y": 2015, "f": ["dlss", "fsr", "reflex", "vk", "dx12", "hdr"], "t": "Vulkan or DX12 client both beat DX11. Reflex 'On + Boost'. Render scaling 100, Lens effects and Zoom-in DOF off.", "r": 25},
  {"n": "PUBG: Battlegrounds", "a": ["PLAYERUNKNOWN'S BATTLEGROUNDS", "PUBG"], "s": [578080], "x": ["TslGame.exe"], "e": "Unreal 4", "g": "Battle Royale", "gpu": 5, "cpu": 6, "c": true, "y": 2017, "cfg": "ue:TslGame", "f": ["dlss", "reflex", "dx11"], "t": "Classic competitive setup: Textures/AA/View distance Ultra, everything else Very Low. Reflex 'On + Boost'.", "r": 3},
  {"n": "Escape from Tarkov", "l": ["Standalone"], "x": ["EscapeFromTarkov.exe"], "e": "Unity", "g": "Extraction Shooter", "gpu": 7, "cpu": 10, "c": true, "y": 2017, "f": ["dlss", "fsr", "reflex"], "t": "Extremely CPU/RAM bound — 32 GB RAM recommended. 'Only use physical cores' off on Ryzen. Object LOD 2, Overall visibility 1000-1500. DLSS lowers GPU load, not CPU."},
  {"n": "Arena Breakout: Infinite", "s": [2073620], "e": "Unreal 4", "g": "Extraction Shooter", "gpu": 6, "cpu": 7, "c": true, "y": 2024, "f": ["dlss", "fsr", "reflex"], "t": "Lower Foliage and Shadows first; Reflex on."},
  {"n": "ARC Raiders", "s": [1808500], "e": "Unreal 5", "g": "Extraction Shooter", "gpu": 6, "cpu": 6, "c": true, "y": 2025, "f": ["dlss", "fg", "mfg", "fsr", "afg", "xess", "tsr", "reflex", "rt", "hdr"], "t": "RTXGI lighting is the biggest cost — use Static/Low GI on mid-range GPUs. DLSS/FSR Quality is near-native here."},
  {"n": "Delta Force", "s": [2507950], "e": "Unreal 4", "g": "FPS", "gpu": 5, "cpu": 6, "c": true, "y": 2024, "f": ["dlss", "fg", "fsr", "afg", "xess", "reflex", "dx12"], "t": "DX12 + Reflex on. Lower Shadows and Volumetric clouds in Havoc Warfare for higher 1% lows."},
  {"n": "The Finals", "s": [2073850], "x": ["Discovery.exe"], "e": "Unreal 5", "g": "FPS", "gpu": 6, "cpu": 6, "c": true, "y": 2023, "cfg": "ue:Discovery", "f": ["dlss", "fg", "fsr", "xess", "tsr", "reflex", "rt"], "t": "RTXGI 'Static' saves a lot on non-RTX cards. Reflex Boost on. Server-side destruction physics are CPU heavy."},
  {"n": "Halo Infinite", "s": [1240440], "e": "Slipspace", "g": "FPS", "gpu": 6, "cpu": 6, "c": true, "y": 2021, "f": ["fsr", "hdr"], "t": "Set Minimum frame rate to your target to drive dynamic resolution. Async compute on. 'Simulation quality' affects CPU.", "r": 60},
  {"n": "Halo: The Master Chief Collection", "s": [976730], "e": "Proprietary", "g": "FPS", "gpu": 2, "cpu": 3, "y": 2019, "f": ["hdr"], "t": "Unlock framerate in settings; Halo 2/3 classic graphics are much lighter.", "r": 166},
  {"n": "Destiny 2", "s": [1085660], "x": ["destiny2.exe"], "e": "Tiger (Bungie)", "g": "Looter Shooter", "gpu": 5, "cpu": 6, "c": true, "y": 2017, "f": ["dlss", "fsr", "reflex", "hdr"], "t": "Shadow Quality and Screen Space AO (3D) are the heaviest. Depth of field off. Use 'Window Mode: Fullscreen' for lowest latency.", "r": 24},
  {"n": "Warframe", "s": [230410], "x": ["Warframe.x64.exe"], "e": "Evolution", "g": "Looter Shooter", "gpu": 3, "cpu": 4, "y": 2013, "f": ["dlss", "fsr", "xess", "reflex", "dx12", "hdr"], "t": "Use DX12 renderer. Particle system quality 'Medium' keeps big endgame squads smooth.", "r": 16},
  {"n": "Team Fortress 2", "s": [440], "x": ["tf_win64.exe", "hl2.exe"], "e": "Source", "g": "Hero Shooter", "gpu": 1, "cpu": 4, "c": true, "y": 2007, "f": ["dx11"], "t": "The 64-bit update made it much smoother; use -dxlevel 95 and a performance config (mastercomfig) for max fps.", "r": 5},
  {"n": "Left 4 Dead 2", "s": [550], "e": "Source", "g": "Co-op FPS", "gpu": 1, "cpu": 3, "y": 2009, "f": ["vk"], "t": "Launch option -vulkan helps on AMD.", "r": 10},
  {"n": "Garry's Mod", "s": [4000], "e": "Source", "g": "Sandbox", "gpu": 2, "cpu": 6, "y": 2006, "f": [], "t": "Switch to the x86-64 beta branch for much higher fps on modern CPUs.", "r": 23},
  {"n": "Half-Life 2", "s": [220], "e": "Source", "g": "FPS", "gpu": 1, "cpu": 2, "y": 2004, "f": ["hdr"], "r": 82},
  {"n": "Half-Life: Alyx", "s": [546560], "e": "Source 2", "g": "VR", "gpu": 6, "cpu": 4, "y": 2020, "f": [], "t": "VR: let SteamVR auto resolution decide; Fidelity 'Low' for older GPUs.", "r": 651},
  {"n": "Portal 2", "s": [620], "e": "Source", "g": "Puzzle", "gpu": 1, "cpu": 2, "y": 2011, "f": ["vk"], "r": 173},
  {"n": "Portal with RTX", "s": [2012840], "e": "Source (RTX Remix)", "g": "Puzzle", "gpu": 10, "cpu": 3, "y": 2022, "f": ["dlss", "fg", "mfg", "rr", "pt", "reflex"], "t": "Full path tracing — DLSS Performance plus Ray Reconstruction is basically required."},
  {"n": "Half-Life 2 RTX", "s": [2477290], "e": "Source (RTX Remix)", "g": "FPS", "gpu": 10, "cpu": 3, "y": 2025, "f": ["dlss", "fg", "mfg", "rr", "pt", "reflex"], "t": "Path traced. Use DLSS Performance + Ray Reconstruction; RTX 40/50 frame gen strongly recommended."},
  {"n": "Deadlock", "s": [1422450], "x": ["deadlock.exe"], "e": "Source 2", "g": "Hero Shooter", "gpu": 4, "cpu": 5, "c": true, "y": 2024, "f": ["fsr", "reflex", "al2", "vk"], "t": "FSR 2 Quality gives a free 25% on mid GPUs. Reflex on, Particle detail Low."},
  {"n": "Titanfall 2", "s": [1237970], "e": "Source (Respawn)", "g": "FPS", "gpu": 3, "cpu": 4, "c": true, "y": 2016, "cap": 144, "f": [], "t": "Capped at 144 fps by default; use +fps_max to raise it. Adaptive resolution off.", "r": 199},
  {"n": "Doom Eternal", "s": [782330], "l": ["GOG"], "e": "id Tech 7", "g": "FPS", "gpu": 3, "cpu": 3, "y": 2020, "f": ["dlss", "reflex", "rt", "vk", "hdr"], "t": "Texture Pool Size is VRAM only, not quality — set to fit your VRAM. Vulkan-only engine, scales extremely well.", "r": 180},
  {"n": "DOOM (2016)", "a": ["DOOM"], "s": [379720], "l": ["GOG"], "e": "id Tech 6", "g": "FPS", "gpu": 3, "cpu": 3, "y": 2016, "f": ["vk"], "t": "Use the Vulkan renderer, not OpenGL.", "r": 149},
  {"n": "DOOM: The Dark Ages", "s": [3017860], "e": "id Tech 8", "g": "FPS", "gpu": 7, "cpu": 6, "y": 2025, "f": ["dlss", "fg", "mfg", "fsr", "afg", "xess", "reflex", "al2", "rt", "pt", "hdr", "vk"], "t": "Ray traced GI is mandatory — needs an RT-capable GPU. Set 'Min target fps' for dynamic resolution. Path tracing patch is for RTX 4080+.", "r": 1901},
  {"n": "Wolfenstein II: The New Colossus", "s": [612880], "e": "id Tech 6", "g": "FPS", "gpu": 4, "cpu": 3, "y": 2017, "f": ["vk", "hdr"], "t": "Async compute on; Image streaming to fit VRAM.", "r": 733},
  {"n": "Indiana Jones and the Great Circle", "s": [2677660], "l": ["GOG"], "e": "id Tech 7 (Motor)", "g": "Action Adventure", "gpu": 8, "cpu": 5, "y": 2024, "f": ["dlss", "fg", "mfg", "rr", "fsr", "xess", "reflex", "rt", "pt", "hdr", "vk"], "t": "Mandatory RT. Texture Pool Size is the #1 cause of stutter — set it one notch under your VRAM. Full RT (path tracing) is RTX 4070 Ti+ territory.", "r": 3459},
  {"n": "Hunt: Showdown 1896", "a": ["Hunt Showdown"], "s": [594650], "e": "CryEngine", "g": "Extraction Shooter", "gpu": 6, "cpu": 6, "c": true, "y": 2019, "f": ["dlss", "fsr", "reflex", "hdr"], "t": "Object/Vegetation quality affects visibility; keep Textures High, lower Shadows/Volumetrics first.", "r": 79},
  {"n": "Insurgency: Sandstorm", "s": [581320], "e": "Unreal 4", "g": "Tactical FPS", "gpu": 6, "cpu": 6, "c": true, "y": 2018, "f": ["dlss", "fsr"], "t": "Lower Post-processing and Effects; foliage is visibility-relevant.", "r": 409},
  {"n": "Squad", "s": [393380], "x": ["SquadGame.exe"], "e": "Unreal 5", "g": "Mil-Sim", "gpu": 7, "cpu": 8, "c": true, "y": 2020, "cfg": "ue:SquadGame", "f": ["dlss", "fsr", "tsr", "reflex"], "t": "UE5 update: disable Lumen GI if your GPU is mid-range. Very CPU heavy in 100-player servers.", "r": 529},
  {"n": "Hell Let Loose", "s": [686810], "x": ["HLL-Win64-Shipping.exe"], "e": "Unreal 4", "g": "Mil-Sim", "gpu": 6, "cpu": 8, "c": true, "y": 2021, "cfg": "ue:HLL", "f": ["dlss", "fsr"], "t": "View distance high (spotting), Shadows/Effects low. CPU bound in heavy fights.", "r": 354},
  {"n": "Arma 3", "s": [107410], "e": "Real Virtuality", "g": "Mil-Sim", "gpu": 5, "cpu": 10, "y": 2013, "f": [], "t": "Single-thread CPU bound. Object view distance matters more than Overall; PIP off.", "r": 83},
  {"n": "Arma Reforger", "s": [1874880], "e": "Enfusion", "g": "Mil-Sim", "gpu": 7, "cpu": 8, "c": true, "y": 2022, "f": ["fsr", "dlss"], "t": "Lower object draw distance first for CPU-bound servers.", "r": 2941},
  {"n": "Ready or Not", "s": [1144200], "e": "Unreal 5", "g": "Tactical FPS", "gpu": 7, "cpu": 6, "y": 2023, "cfg": "ue:ReadyOrNot", "f": ["dlss", "fg", "fsr", "afg", "xess", "tsr", "reflex"], "t": "Shadows and Lumen-style GI are the main GPU costs.", "r": 218},

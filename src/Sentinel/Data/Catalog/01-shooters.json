  {"n": "Tiny Tina's Wonderlands", "s": [1286680], "e": "Unreal 4", "g": "Looter Shooter", "gpu": 6, "cpu": 5, "y": 2022, "f": ["fsr", "dx12", "hdr"], "r": 676},

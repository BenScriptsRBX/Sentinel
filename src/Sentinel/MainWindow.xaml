<Window x:Class="Sentinel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Sentinel.Views"
        Title="Sentinel - Game Optimizer" Width="1400" Height="900" MinWidth="1120" MinHeight="700"
        Icon="Assets/Sentinel.ico"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <v:EqualsToVisibility x:Key="EqVis" />
        <v:EqualsToBool x:Key="EqBool" />
        <v:BoolToVisibility x:Key="BoolVis" />
        <v:BoolToVisibility x:Key="NotVis" Invert="True" />
        <v:ScoreToArc x:Key="Arc" />

        <Style x:Key="NavCaption" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Margin" Value="14,18,0,6" />
            <Setter Property="FontSize" Value="10.5" />
        </Style>
        <Style x:Key="NavBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="7,1" />
            <Setter Property="Background" Value="#1AFFFFFF" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="NavLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Border x:Name="Root" BorderBrush="{StaticResource Line}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="252" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============================== sidebar -->
            <Border Background="{StaticResource SidebarFill}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                <Grid>
                    <!-- soft glow behind the brand -->
                    <Ellipse Width="320" Height="240" Fill="{StaticResource GlowViolet}" HorizontalAlignment="Left" VerticalAlignment="Top"
                             Margin="-120,-130,0,0" IsHitTestVisible="False" />
                    <DockPanel Margin="16,16,16,16">
                        <!-- brand -->
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,4,0,8">
                            <Image Source="{StaticResource LogoImage}" Width="40" Height="40" Effect="{StaticResource AccentGlow}" />
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Sentinel" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextGradient}" />
                                <TextBlock Text="GAME OPTIMIZER" Style="{StaticResource Caption}" FontSize="9.5" Margin="1,-1,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <!-- rig card -->
                        <Border DockPanel.Dock="Bottom" Style="{StaticResource CardBorder}" Padding="14" CornerRadius="14">
                            <Grid>
                            <!-- placeholder while the first scan runs, so the card never shows "Unknown GPU" -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding IsScanning, Converter={StaticResource BoolVis}}">
                                <Image Source="{StaticResource LogoImage}" Width="28" Height="28" Opacity="0.7" Margin="0,0,10,0" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="YOUR RIG" Style="{StaticResource Caption}" FontSize="10" />
                                    <TextBlock Text="Detecting your hardware…" Foreground="{StaticResource Muted}" FontSize="12" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Visibility="{Binding IsScanning, Converter={StaticResource NotVis}}">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Left" Width="46" Height="46" Margin="0,0,12,0">
                                        <Viewbox>
                                            <Grid Width="140" Height="140">
                                                <Path Data="{Binding Source=100, Converter={StaticResource Arc}}" Stroke="#24FFFFFF" StrokeThickness="16" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                <Path Data="{Binding OverallScore, Converter={StaticResource Arc}}" Stroke="{StaticResource AccentGradient}" StrokeThickness="16" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                            </Grid>
                                        </Viewbox>
                                        <TextBlock Text="{Binding OverallScore}" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0" />
                                    </Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="YOUR RIG" Style="{StaticResource Caption}" FontSize="10" />
                                        <TextBlock Text="{Binding Tier}" FontWeight="SemiBold" Foreground="#C9BBFF" Margin="0,1,0,0" />
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock Text="{Binding GpuLine}" FontWeight="SemiBold" FontSize="12" Margin="0,10,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding GpuLine}" />
                                <TextBlock Text="{Binding CpuLine}" Foreground="{StaticResource Muted}" FontSize="11.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding CpuLine}" Margin="0,2,0,0" />
                            </StackPanel>
                            </Grid>
                        </Border>
                        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Caption}" FontWeight="Normal" FontSize="10.5" Margin="14,0,0,10">
                            <Run Text="{Binding VersionLabel, Mode=OneWay}" /> · <Hyperlink Command="{Binding OpenRepoCommand}" Foreground="{StaticResource Muted}" TextDecorations="None"
                                       ToolTip="Open the project on GitHub">GitHub</Hyperlink> · <Run Text="{Binding CatalogCountShort, Mode=OneWay}" /> games
                        </TextBlock>

                        <!-- navigation -->
                        <StackPanel>
                            <TextBlock Text="OVERVIEW" Style="{StaticResource NavCaption}" />
                            <RadioButton Style="{StaticResource NavButton}" Tag="&#xE80F;"
                                         IsChecked="{Binding CurrentPage, Converter={StaticResource EqBool}, ConverterParameter=Dashboard}">
                                <TextBlock Text="Dashboard" Style="{StaticResource NavLabel}" />
                            </RadioButton>

                            <TextBlock Text="GAMES" Style="{StaticResource NavCaption}" />
                            <RadioButton Style="{StaticResource NavButton}" Tag="&#xE7FC;"
                                         IsChecked="{Binding CurrentPage, Converter={StaticResource EqBool}, ConverterParameter=Library}">
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource NavBadge}">
                                        <TextBlock Text="{Binding GameCount}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
                                    </Border>
                                    <TextBlock Text="My Games" Style="{StaticResource NavLabel}" />
                                </DockPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource NavButton}" Tag="&#xE8F1;"
                                         IsChecked="{Binding CurrentPage, Converter={StaticResource EqBool}, ConverterParameter=Catalog}">
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource NavBadge}">
                                        <TextBlock Text="{Binding CatalogCountShort}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
                                    </Border>
                                    <TextBlock Text="Game Catalog" Style="{StaticResource NavLabel}" />
                                </DockPanel>
                            </RadioButton>

                            <TextBlock Text="SYSTEM" Style="{StaticResource NavCaption}" />
                            <RadioButton Style="{StaticResource NavButton}" Tag="&#xE90F;"
                                         IsChecked="{Binding CurrentPage, Converter={StaticResource EqBool}, ConverterParameter=Tweaks}">
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource NavBadge}" Background="{StaticResource WarnSoft}"
                                            Visibility="{Binding RecommendedTweakCount, Converter={StaticResource BoolVis}}">
                                        <TextBlock Text="{Binding RecommendedTweakCount}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Warn}" />
                                    </Border>
                                    <TextBlock Text="PC Tweaks" Style="{StaticResource NavLabel}" />
                                </DockPanel>
                            </RadioButton>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>

            <!-- ============================== content -->
            <Grid Grid.Column="1" ClipToBounds="True">
                <!-- backdrop -->
                <Rectangle Fill="{StaticResource DotGrid}" OpacityMask="{StaticResource FadeDown}" IsHitTestVisible="False" />
                <Ellipse Width="980" Height="720" Fill="{StaticResource GlowViolet}" HorizontalAlignment="Right" VerticalAlignment="Top"
                         Margin="0,-400,-360,0" IsHitTestVisible="False" />
                <Ellipse Width="760" Height="620" Fill="{StaticResource GlowCyan}" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                         Margin="-340,0,0,-380" IsHitTestVisible="False" />

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- title bar -->
                    <DockPanel Grid.Row="0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource ChromeButton}" Content="&#xE921;" Click="OnMinimize" />
                            <Button Style="{StaticResource ChromeButton}" Content="&#xE922;" Click="OnMaximize" />
                            <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="OnClose" />
                        </StackPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="12,5" Margin="0,0,8,0" VerticalAlignment="Center"
                                BorderThickness="0" WindowChrome.IsHitTestVisibleInChrome="True" Command="{Binding RescanCommand}" ToolTip="Detect hardware and games again">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
                                <TextBlock Text="Rescan" Foreground="{StaticResource Muted}" />
                            </StackPanel>
                        </Button>
                        <StackPanel Orientation="Horizontal" Margin="28,0,0,0" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Margin="0,0,8,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource Good}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource Warn}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource Muted}" FontSize="12" />
                        </StackPanel>
                    </DockPanel>

                    <Grid Grid.Row="1">
                        <v:DashboardView Visibility="{Binding CurrentPage, Converter={StaticResource EqVis}, ConverterParameter=Dashboard}" />
                        <v:LibraryView Visibility="{Binding CurrentPage, Converter={StaticResource EqVis}, ConverterParameter=Library}" />
                        <v:CatalogView Visibility="{Binding CurrentPage, Converter={StaticResource EqVis}, ConverterParameter=Catalog}" />
                        <v:TweaksView Visibility="{Binding CurrentPage, Converter={StaticResource EqVis}, ConverterParameter=Tweaks}" />
                    </Grid>
                </Grid>

                <!-- scanning overlay -->
                <Border Background="#F20B0D12" Visibility="{Binding IsScanning, Converter={StaticResource BoolVis}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid Width="128" Height="128" HorizontalAlignment="Center">
                            <Ellipse Fill="{StaticResource GlowViolet}" Margin="-40" />
                            <Ellipse Stroke="#1AFFFFFF" StrokeThickness="2" />
                            <Ellipse Stroke="{StaticResource AccentGradient}" StrokeThickness="3" StrokeDashArray="14 26" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform />
                                </Ellipse.RenderTransform>
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                 From="0" To="360" Duration="0:0:2.2" RepeatBehavior="Forever" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <Image Source="{StaticResource LogoImage}" Width="66" Height="66" RenderTransformOrigin="0.5,0.5">
                                <Image.RenderTransform>
                                    <ScaleTransform />
                                </Image.RenderTransform>
                                <Image.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="1" To="1.07" Duration="0:0:0.9">
                                                    <DoubleAnimation.EasingFunction>
                                                        <SineEase EasingMode="EaseInOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="1" To="1.07" Duration="0:0:0.9">
                                                    <DoubleAnimation.EasingFunction>
                                                        <SineEase EasingMode="EaseInOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Image.Triggers>
                            </Image>
                        </Grid>
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource H3}" FontSize="15" HorizontalAlignment="Center" Margin="0,26,0,4" />
                        <TextBlock Text="Reading hardware, launchers and game configs" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>

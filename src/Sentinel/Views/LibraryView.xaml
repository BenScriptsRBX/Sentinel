<UserControl x:Class="Sentinel.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Sentinel.Views">
    <UserControl.Resources>
        <v:BoolToVisibility x:Key="BoolVis" />
        <v:BoolToVisibility x:Key="NotVis" Invert="True" />
    </UserControl.Resources>
    <Grid Margin="28,8,20,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel>
            <StackPanel DockPanel.Dock="Top">
                <v:PageHeader Glyph="&#xE7FC;" Title="My Games" Subtitle="{Binding LibrarySubtitle}" Margin="0,6,0,18" />
                <TextBox Style="{StaticResource SearchBox}" Tag="Search your games" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
                <CheckBox Style="{StaticResource Switch}" Content="Auto-tunable only" IsChecked="{Binding AutoOnly}" Margin="2,12,0,10" Foreground="{StaticResource Muted}" />
            </StackPanel>
            <Grid>
                <ListBox ItemsSource="{Binding GamesView}" SelectedItem="{Binding SelectedGame}" ItemContainerStyle="{StaticResource GameListItem}" Margin="-6,0,0,16">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="82" Height="38" CornerRadius="9" Background="{Binding AvatarBackground}" Margin="0,0,12,0"
                        BorderBrush="#26FFFFFF" BorderThickness="1" VerticalAlignment="Center">
                    <Grid>
                        <TextBlock Text="{Binding Initial}" FontWeight="Bold" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding HasIcon, Converter={StaticResource NotVis}}" />
                        <Image Source="{Binding SquareIcon}" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>
                </Border>
                                <Border DockPanel.Dock="Right" CornerRadius="999" Padding="7,2" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#14FFFFFF" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CanAutoApply}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource InfoSoft}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding SupportLabel}" FontSize="10" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource Faint}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CanAutoApply}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource Accent2}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Style="{StaticResource MutedText}" FontSize="11.5" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Launcher, Mode=OneWay}" /> · <Run Text="{Binding Engine, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="No games found yet. Install a game through Steam, Epic, GOG, Ubisoft, EA, Battle.net, Riot or Xbox and press Rescan."
                           Style="{StaticResource MutedText}" Margin="4,20" Visibility="{Binding GameCount, Converter={StaticResource NotVis}}" />
            </Grid>
        </DockPanel>

        <v:GameDetailView Grid.Column="2" DataContext="{Binding SelectedGame}" Margin="0,8,0,0"
                          Visibility="{Binding DataContext, RelativeSource={RelativeSource Self}, Converter={StaticResource BoolVis}}" />
    </Grid>
</UserControl>

<UserControl x:Class="Sentinel.Views.GameDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Sentinel.Views">
    <UserControl.Resources>
        <v:BoolToVisibility x:Key="BoolVis" />
        <v:BoolToVisibility x:Key="NotVis" Invert="True" />
        <v:LevelToBrush x:Key="LevelBrush" />
        <v:LevelToPercent x:Key="LevelPct" />
        <v:KindToBrush x:Key="KindBrush" />
        <v:KindToIcon x:Key="KindIcon" />

        <!-- Five equal preset tiles across the card. -->
        <Style x:Key="PresetList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Margin" Value="-4,0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="IsEnabled" Value="{Binding Achievable}" />
                        <Setter Property="ToolTip" Value="{Binding Hint}" />
                        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
                        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="b" CornerRadius="12" Padding="10,10" Margin="4,0" Background="{StaticResource Surface}"
                                            BorderBrush="{StaticResource Line}" BorderThickness="1">
                                        <ContentPresenter HorizontalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="{StaticResource CardHover}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}" />
                                            <Setter TargetName="b" Property="Background">
                                                <Setter.Value>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#407C5CFF" Offset="0" />
                                                        <GradientStop Color="#1A22D3EE" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="b" Property="Opacity" Value="0.35" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeroChip" TargetType="Border" BasedOn="{StaticResource Chip}">
            <Setter Property="Background" Value="#26FFFFFF" />
            <Setter Property="Margin" Value="0,0,6,6" />
        </Style>
        <Style x:Key="LegendDot" TargetType="Border">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4,0,10,24">

            <!-- ============================== hero -->
            <Grid Height="212" Margin="0,0,0,16">
                <Border CornerRadius="18" Background="{Binding HeroBackground}" />
                <Border CornerRadius="18">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FA0B0D12" Offset="0" />
                            <GradientStop Color="#EB0B0D12" Offset="0.38" />
                            <GradientStop Color="#B30B0D12" Offset="0.68" />
                            <GradientStop Color="#990B0D12" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Border CornerRadius="18">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#000B0D12" Offset="0.4" />
                            <GradientStop Color="#B30B0D12" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Border CornerRadius="18" BorderBrush="#33FFFFFF" BorderThickness="1" />

                <Grid Margin="24,22,22,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <DockPanel>
                        <WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                            <Border Style="{StaticResource FactPill}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7F8;" Style="{StaticResource Icon}" FontSize="12" Foreground="#C9BBFF" Margin="0,0,6,0" />
                                    <TextBlock FontSize="11.5" Foreground="{StaticResource Text}"><Run Text="GPU " Foreground="{StaticResource Muted}" /><Run Text="{Binding GpuDemandLabel, Mode=OneWay}" /></TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource FactPill}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE950;" Style="{StaticResource Icon}" FontSize="12" Foreground="#7DE9FA" Margin="0,0,6,0" />
                                    <TextBlock FontSize="11.5" Foreground="{StaticResource Text}"><Run Text="CPU " Foreground="{StaticResource Muted}" /><Run Text="{Binding CpuDemandLabel, Mode=OneWay}" /></TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource FactPill}" Visibility="{Binding Year, Converter={StaticResource BoolVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE787;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding Year}" FontSize="11.5" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource FactPill}" Visibility="{Binding FeatureLine, Converter={StaticResource BoolVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE945;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource Good}" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding FeatureLine}" FontSize="11.5" TextTrimming="CharacterEllipsis" MaxWidth="300" ToolTip="{Binding FeatureLine}" />
                                </StackPanel>
                            </Border>
                        </WrapPanel>

                        <DockPanel VerticalAlignment="Center">
                            <Border DockPanel.Dock="Left" Width="138" Height="64" CornerRadius="12" Background="{Binding AvatarBackground}" Margin="0,0,18,0"
                                    BorderBrush="#40FFFFFF" BorderThickness="1" VerticalAlignment="Center" Effect="{StaticResource SoftShadow}">
                                <Grid>
                                    <TextBlock Text="{Binding Initial}" FontWeight="Bold" FontSize="28" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding HasIcon, Converter={StaticResource NotVis}}" />
                                    <Image Source="{Binding SquareIcon}" Width="46" Height="46" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </Grid>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <!-- Long names shrink to fit one line (down to ~60% size); past that they're trimmed. -->
                                <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource H1}" FontSize="28" MaxWidth="400" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                </Viewbox>
                                <WrapPanel Margin="0,8,0,0">
                                    <Border Style="{StaticResource HeroChip}"><TextBlock Text="{Binding Launcher}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Text}" /></Border>
                                    <Border Style="{StaticResource HeroChip}"><TextBlock Text="{Binding Engine}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Text}" /></Border>
                                    <Border Style="{StaticResource HeroChip}"><TextBlock Text="{Binding Genre}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Text}" /></Border>
                                    <Border Style="{StaticResource HeroChip}" Background="#3322D3EE" Visibility="{Binding CanAutoApply, Converter={StaticResource BoolVis}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="10" Foreground="{StaticResource Accent2}" Margin="0,0,5,0" />
                                            <TextBlock Text="{Binding SupportLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Accent2}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource HeroChip}" Background="#33FBBF24" Visibility="{Binding IsCatalogued, Converter={StaticResource NotVis}}">
                                        <TextBlock Text="Not in catalog · generic profile" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Warn}" />
                                    </Border>
                                </WrapPanel>
                            </StackPanel>
                        </DockPanel>
                    </DockPanel>

                    <!-- frosted expected-performance panel -->
                    <Border Grid.Column="1" CornerRadius="16" Padding="20,14,20,14" Margin="20,0,0,0" VerticalAlignment="Center" MinWidth="230"
                            BorderBrush="#33FFFFFF" BorderThickness="1" Background="#C70E1118">
                        <StackPanel>
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" Background="#1FFFFFFF" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding BoundLabel}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
                                </Border>
                                <TextBlock Text="EXPECTED" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                            </DockPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="{Binding EstimatedFps}" Style="{StaticResource BigNumber}" FontSize="54" Foreground="{StaticResource TextGradient}" />
                                <TextBlock Text="fps" FontSize="18" Foreground="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="6,0,0,12" />
                            </StackPanel>
                            <TextBlock Text="{Binding BaseFpsLine}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,-6,0,8" />
                            <Border Style="{StaticResource Chip}" Background="{StaticResource GoodSoft}" HorizontalAlignment="Left" Margin="0"
                                    Visibility="{Binding TargetReached, Converter={StaticResource BoolVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="10" Foreground="{StaticResource Good}" Margin="0,0,5,0" />
                                    <TextBlock Text="{Binding TargetLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Good}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Chip}" Background="{StaticResource WarnSoft}" HorizontalAlignment="Left" Margin="0"
                                    Visibility="{Binding TargetReached, Converter={StaticResource NotVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="10" Foreground="{StaticResource Warn}" Margin="0,0,5,0" />
                                    <TextBlock Text="{Binding TargetLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Warn}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- ============================== fps target -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,16">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE9D9;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource Accent2}" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding CeilingLine}" Style="{StaticResource MutedText}" FontSize="12" TextWrapping="NoWrap" />
                        </StackPanel>
                        <Label Style="{StaticResource Section}" Content="FPS target" />
                    </DockPanel>

                    <ListBox Style="{StaticResource PresetList}" ItemsSource="{Binding PresetOptions}" SelectedItem="{Binding SelectedPresetOption}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Preset.Label}" FontWeight="SemiBold" FontSize="12.5" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding Preset.Range}" Foreground="{StaticResource Muted}" FontSize="11.5" HorizontalAlignment="Center" Margin="0,1,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*" />
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="74" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Minimum" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Minimum="20" Maximum="400" Value="{Binding MinFps}" VerticalAlignment="Center" Margin="0,0,12,0" SmallChange="5" LargeChange="10" />
                            <TextBox Grid.Column="2" Style="{StaticResource NumberBox}" Text="{Binding MinFps, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Grid.Row="2" Text="Maximum" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                            <Slider Grid.Row="2" Grid.Column="1" Minimum="30" Maximum="500" Value="{Binding MaxFps}" VerticalAlignment="Center" Margin="0,0,12,0" SmallChange="5" LargeChange="10" />
                            <TextBox Grid.Row="2" Grid.Column="2" Style="{StaticResource NumberBox}" Text="{Binding MaxFps, UpdateSourceTrigger=LostFocus}" />
                        </Grid>

                        <StackPanel Grid.Column="2">
                            <ComboBox ItemsSource="{Binding Resolutions}" SelectedItem="{Binding Resolution}" ToolTip="Resolution used for the estimate" />
                            <UniformGrid Columns="2" Margin="0,14,0,0">
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Competitive}" Content="Competitive" Margin="0,0,0,10"
                                          ToolTip="Prioritises visibility and input latency: clutter settings low, native resolution kept, no frame generation." />
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding AllowUpscaling}" Content="Upscaling" Margin="0,0,0,10" />
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding AllowFrameGen}" Content="Frame gen" />
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding AllowRayTracing}" Content="Ray tracing" />
                            </UniformGrid>
                        </StackPanel>
                    </Grid>

                    <Border Margin="0,10,0,0" CornerRadius="10" Background="{StaticResource WarnSoft}" Padding="12,8"
                            Visibility="{Binding TargetUnreachable, Converter={StaticResource BoolVis}}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource Warn}" Margin="0,0,10,0" />
                            <TextBlock Text="That minimum is above what this PC can do here — the plan below targets the best it can actually hold."
                                       Foreground="{StaticResource Warn}" FontSize="12" TextWrapping="Wrap" />
                        </DockPanel>
                    </Border>

                    <Border Margin="0,16,0,0" CornerRadius="12" Background="#0AFFFFFF" BorderBrush="#12FFFFFF" BorderThickness="1" Padding="16,12,16,8">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Style="{StaticResource LegendDot}" Background="#557C5CFF" BorderBrush="#9B7CFF" BorderThickness="1" />
                                <TextBlock Text="Your target" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,16,0" />
                                <Border Style="{StaticResource LegendDot}" Background="{StaticResource AccentGradient}" />
                                <TextBlock Text="Expected range" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,16,0" />
                                <Border Style="{StaticResource LegendDot}" Background="{StaticResource Accent2}" Width="3" />
                                <TextBlock Text="Display refresh" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,16,0" />
                                <Border Style="{StaticResource LegendDot}" Background="{StaticResource Warn}" Width="3" />
                                <TextBlock Text="Hardware max" FontSize="11" Foreground="{StaticResource Muted}" />
                            </StackPanel>
                            <v:FpsRangeBar TargetMin="{Binding MinFps}" TargetMax="{Binding MaxFps}" Estimate="{Binding PlanEstimate}" Typical="{Binding PlanTypical}"
                                           Ceiling="{Binding PlanCeiling}" Refresh="{Binding DisplayRefresh, Mode=OneWay}" EngineCap="{Binding PlanEngineCap}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ============================== apply bar -->
            <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0" Padding="18,16">
                <!-- Row 0: what Sentinel will edit. Row 1 (installed only): actions on their own line so nothing gets squeezed. -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <Grid DockPanel.Dock="Left" Width="40" Height="40" Margin="0,0,14,0" VerticalAlignment="Top">
                            <Border CornerRadius="11" Background="{StaticResource InfoSoft}" />
                            <TextBlock Text="&#xE90F;" Style="{StaticResource Icon}" FontSize="16" Foreground="{StaticResource Accent2}" HorizontalAlignment="Center" />
                        </Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding AdapterName}" Style="{StaticResource H3}" />
                            <TextBlock Text="{Binding SupportDetail}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,2,0,0" Visibility="{Binding IsInstalled, Converter={StaticResource BoolVis}}" />
                            <TextBlock Text="Not installed — showing estimates for your hardware." Style="{StaticResource MutedText}" FontSize="12" Margin="0,2,0,0" Visibility="{Binding IsInstalled, Converter={StaticResource NotVis}}" />
                        </StackPanel>
                    </DockPanel>

                    <DockPanel Grid.Row="1" Margin="54,12,0,0" Visibility="{Binding IsInstalled, Converter={StaticResource BoolVis}}">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource GhostButton}" Padding="11,9" Margin="8,0,0,0" Command="{Binding OpenInstallCommand}" ToolTip="Open install folder">
                                <TextBlock Text="&#xE838;" Style="{StaticResource Icon}" FontSize="14" Foreground="{StaticResource Muted}" />
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Padding="11,9" Margin="8,0,0,0" Command="{Binding OpenConfigCommand}" ToolTip="Show the config file Sentinel edits"
                                    Visibility="{Binding HasConfig, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="&#xE8A5;" Style="{StaticResource Icon}" FontSize="14" Foreground="{StaticResource Muted}" />
                            </Button>
                            <Button Content="Use dedicated GPU" Margin="8,0,0,0" Command="{Binding ForceGpuCommand}" Visibility="{Binding ShowForceGpu, Converter={StaticResource BoolVis}}"
                                    ToolTip="Set Windows' per-app graphics preference to High performance for this game" />
                            <Button Content="Restore backup" Margin="8,0,0,0" Command="{Binding RestoreCommand}" Visibility="{Binding CanAutoApply, Converter={StaticResource BoolVis}}" />
                            <Button Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Padding="20,10" Command="{Binding ApplyCommand}" Visibility="{Binding CanAutoApply, Converter={StaticResource BoolVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE945;" Style="{StaticResource Icon}" FontSize="14" Foreground="White" Margin="0,0,8,0" />
                                    <TextBlock Text="Apply to game" Foreground="White" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding ConfigPath}" Style="{StaticResource Caption}" FontWeight="Normal" TextTrimming="CharacterEllipsis" ToolTip="{Binding ConfigPath}"
                                   Visibility="{Binding HasConfig, Converter={StaticResource BoolVis}}" />
                        <TextBlock Text="{Binding Status}" Margin="0,4,0,0" TextWrapping="Wrap" FontWeight="SemiBold" Visibility="{Binding Status, Converter={StaticResource BoolVis}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource Good}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Warn}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>

            <!-- ============================== settings -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CardBorder}" VerticalAlignment="Top">
                    <StackPanel>
                        <Label Style="{StaticResource Section}" Content="Modern settings" Margin="0,0,0,10" />
                        <ItemsControl ItemsSource="{Binding Modern}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,11">
                                        <DockPanel>
                                            <Grid DockPanel.Dock="Left" Width="26" Height="26" Margin="0,0,12,0" VerticalAlignment="Top">
                                                <Ellipse Fill="#12FFFFFF" />
                                                <TextBlock Text="{Binding Kind, Converter={StaticResource KindIcon}}" Style="{StaticResource Icon}" FontSize="11"
                                                           Foreground="{Binding Kind, Converter={StaticResource KindBrush}}" HorizontalAlignment="Center" />
                                            </Grid>
                                            <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" Background="{StaticResource InfoSoft}" Margin="10,0,0,0" VerticalAlignment="Top"
                                                    Visibility="{Binding AutoApplied, Converter={StaticResource BoolVis}}">
                                                <TextBlock Text="Auto" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Accent2}" />
                                            </Border>
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" FontWeight="SemiBold" TextAlignment="Right" TextWrapping="Wrap" MaxWidth="220" />
                                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource Muted}" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" FontWeight="Normal" FontSize="11.5" TextWrapping="Wrap" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <Label Style="{StaticResource Section}" Content="Graphics settings" Margin="0,0,0,12" />
                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="122" />
                                                <ColumnDefinition Width="*" MinWidth="60" />
                                                <ColumnDefinition Width="54" />
                                                <ColumnDefinition Width="56" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0" Height="6">
                                                <Border CornerRadius="3" Background="{StaticResource Line}" />
                                                <ProgressBar Style="{StaticResource Meter}" Height="6" Value="{Binding LevelIndex, Converter={StaticResource LevelPct}, Mode=OneWay}"
                                                             Foreground="{Binding LevelIndex, Converter={StaticResource LevelBrush}}" />
                                            </Grid>
                                            <TextBlock Grid.Column="2" Text="{Binding LevelName}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{Binding LevelIndex, Converter={StaticResource LevelBrush}}" />
                                            <Border Grid.Column="3" CornerRadius="999" Padding="8,2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#14FFFFFF" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding AutoApplied}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource InfoSoft}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="10.5" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="Manual" />
                                                            <Setter Property="Foreground" Value="{StaticResource Faint}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding AutoApplied}" Value="True">
                                                                    <Setter Property="Text" Value="Auto" />
                                                                    <Setter Property="Foreground" Value="{StaticResource Accent2}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock DockPanel.Dock="Right" Text="native · conservative" Style="{StaticResource Caption}" FontWeight="Normal" VerticalAlignment="Center" />
                                <Label Style="{StaticResource Section}" Content="Preset estimates" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding PresetFps}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="64" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource Muted}" />
                                            <ProgressBar Grid.Column="1" Style="{StaticResource Meter}" Value="{Binding Bar, Mode=OneWay}" Height="6" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" HorizontalAlignment="Right" FontWeight="SemiBold">
                                                <Run Text="{Binding Fps, Mode=OneWay}" /><Run Text=" fps" Foreground="{StaticResource Faint}" FontSize="11" FontWeight="Normal" />
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
                        <StackPanel>
                            <Label Style="{StaticResource Section}" Content="Notes for this game" Margin="0,0,0,10" />
                            <ItemsControl ItemsSource="{Binding Notes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,4">
                                            <Border DockPanel.Dock="Left" Width="6" Height="6" CornerRadius="3" Background="{StaticResource AccentGradient}" VerticalAlignment="Top" Margin="0,7,10,0" />
                                            <TextBlock Text="{Binding}" Style="{StaticResource MutedText}" FontSize="12.5" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding GpuDemandLabel}" Style="{StaticResource Caption}" FontWeight="Normal" />
                                        <TextBlock Text="GPU DEMAND" Style="{StaticResource Caption}" />
                                    </DockPanel>
                                    <ProgressBar Style="{StaticResource Meter}" Value="{Binding GpuDemand, Mode=OneWay}" Margin="0,6,0,0" Height="4" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding CpuDemandLabel}" Style="{StaticResource Caption}" FontWeight="Normal" />
                                        <TextBlock Text="CPU DEMAND" Style="{StaticResource Caption}" />
                                    </DockPanel>
                                    <ProgressBar Style="{StaticResource Meter}" Value="{Binding CpuDemand, Mode=OneWay}" Margin="0,6,0,0" Height="4" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <TextBlock Text="Estimates come from Sentinel's performance model (catalog demand × your GPU/CPU scores) and show the conservative end of the range. Real results vary by scene, driver and patch — verify with an in-game benchmark."
                       Style="{StaticResource Caption}" FontWeight="Normal" TextWrapping="Wrap" Margin="2,16,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>

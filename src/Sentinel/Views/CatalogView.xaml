<UserControl x:Class="Sentinel.Views.CatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Sentinel.Views">
    <UserControl.Resources>
        <v:BoolToVisibility x:Key="BoolVis" />
        <v:BoolToVisibility x:Key="NotVis" Invert="True" />
    </UserControl.Resources>
    <Grid Margin="28,8,20,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel>
            <StackPanel DockPanel.Dock="Top">
                <v:PageHeader Glyph="&#xE8F1;" Title="Game Catalog" Subtitle="{Binding CatalogSubtitle}" Margin="0,6,0,18" />
                <TextBox Style="{StaticResource SearchBox}" Tag="Search by name or engine" Text="{Binding CatalogSearch, UpdateSourceTrigger=PropertyChanged}" />
                <Grid Margin="0,10,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="140" />
                    </Grid.ColumnDefinitions>
                    <ComboBox ItemsSource="{Binding GenreFilters}" SelectedItem="{Binding GenreFilter}" />
                    <ComboBox Grid.Column="2" ItemsSource="{Binding SortModes}" SelectedItem="{Binding SortMode}" />
                </Grid>
                <DockPanel Margin="54,0,10,4">
                    <TextBlock DockPanel.Dock="Right" Text="HIGH · NATIVE" Style="{StaticResource Caption}" />
                    <TextBlock Text="GAME" Style="{StaticResource Caption}" />
                </DockPanel>
            </StackPanel>
            <ListBox ItemsSource="{Binding CatalogView}" SelectedItem="{Binding SelectedCatalogGame}" ItemContainerStyle="{StaticResource GameListItem}" Margin="-6,0,0,16">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="74" Height="34" CornerRadius="8" Background="{Binding AvatarBackground}" Margin="0,0,12,0"
                        BorderBrush="#26FFFFFF" BorderThickness="1" VerticalAlignment="Center">
                    <Grid>
                        <TextBlock Text="{Binding Initial}" FontWeight="Bold" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding HasIcon, Converter={StaticResource NotVis}}" />
                        <Image Source="{Binding SquareIcon}" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>
                </Border>
                            <StackPanel DockPanel.Dock="Right" Width="56" VerticalAlignment="Center">
                                <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold">
                                    <Run Text="{Binding HighPresetFps, Mode=OneWay}" /><Run Text=" fps" Foreground="{StaticResource Faint}" FontSize="10.5" />
                                </TextBlock>
                                <ProgressBar Style="{StaticResource Meter}" Value="{Binding HighPresetBar, Mode=OneWay}" Height="3" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="200" />
                                    <TextBlock Text=" &#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{StaticResource Good}" VerticalAlignment="Center"
                                               ToolTip="Installed" Visibility="{Binding IsInstalled, Converter={StaticResource BoolVis}}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource MutedText}" FontSize="11.5" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding Genre, Mode=OneWay}" /> · <Run Text="{Binding Engine, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <v:GameDetailView Grid.Column="2" DataContext="{Binding SelectedCatalogGame}" Margin="0,8,0,0"
                          Visibility="{Binding DataContext, RelativeSource={RelativeSource Self}, Converter={StaticResource BoolVis}}" />
    </Grid>
</UserControl>

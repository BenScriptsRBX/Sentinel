<UserControl x:Class="Sentinel.Views.TweaksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Sentinel.Views">
    <UserControl.Resources>
        <v:BoolToVisibility x:Key="BoolVis" />
        <v:TweakStatusToBrush x:Key="StatusBrush" />
        <v:TweakStatusToBrush x:Key="StatusSoft" Soft="True" />
        <v:ImpactToBrush x:Key="ImpactBrush" />
        <v:CategoryToGlyph x:Key="CategoryGlyph" />
        <v:ScoreToArc x:Key="Arc" />

        <Style x:Key="LegendItem" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Margin" Value="0,0,18,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,6,28,28">
            <v:PageHeader Glyph="&#xE90F;" Title="PC Tweaks"
                          Subtitle="Windows, display, driver and hardware recommendations for your PC. Every change Sentinel makes can be reverted.">
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding ApplyAllTweaksCommand}"
                        ToolTip="Applies every recommended tweak that doesn't need administrator rights. Each one can be reverted.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE945;" Style="{StaticResource Icon}" FontSize="14" Foreground="White" Margin="0,0,8,0" />
                        <TextBlock Text="Apply safe recommendations" Foreground="White" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
            </v:PageHeader>

            <!-- ============================== health summary -->
            <Grid Margin="0,0,0,22">
                <Border CornerRadius="18" Background="{StaticResource HeroGradient}" />
                <Border CornerRadius="18" BorderThickness="1" BorderBrush="#33FFFFFF" />
                <Grid Margin="24,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="96" Height="96" Margin="0,0,24,0">
                        <Viewbox>
                            <Grid Width="140" Height="140">
                                <Path Data="{Binding Source=100, Converter={StaticResource Arc}}" Stroke="#24FFFFFF" StrokeThickness="13" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <Path Data="{Binding HealthPercent, Converter={StaticResource Arc}}" Stroke="{StaticResource AccentGradient}" StrokeThickness="13" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Grid>
                        </Viewbox>
                        <TextBlock Text="{Binding HealthPercent, StringFormat={}{0}%}" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4,0,0" />
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource H2}">
                            <Run Text="PC health · " /><Run Text="{Binding HealthLabel, Mode=OneWay}" Foreground="{StaticResource TextGradient}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,12">
                            <Run Text="{Binding OptimalCount, Mode=OneWay}" /> checks already optimal, <Run Text="{Binding RecommendedCount, Mode=OneWay}" /> recommended changes, <Run Text="{Binding AttentionCount, Mode=OneWay}" /> need your attention (BIOS or hardware).
                        </TextBlock>
                        <!-- status breakdown -->
                        <Border CornerRadius="5" Height="10" ClipToBounds="True" Background="{StaticResource Line}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding OptimalStar}" />
                                    <ColumnDefinition Width="{Binding RecommendedStar}" />
                                    <ColumnDefinition Width="{Binding AttentionStar}" />
                                    <ColumnDefinition Width="{Binding TipStar}" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{StaticResource Good}" Margin="0,0,2,0" CornerRadius="5,0,0,5" />
                                <Border Grid.Column="1" Background="{StaticResource Accent}" Margin="0,0,2,0" />
                                <Border Grid.Column="2" Background="{StaticResource Warn}" Margin="0,0,2,0" />
                                <Border Grid.Column="3" Background="{StaticResource Accent2}" Opacity="0.6" CornerRadius="0,5,5,0" />
                            </Grid>
                        </Border>
                        <WrapPanel Margin="0,10,0,0">
                            <StackPanel Style="{StaticResource LegendItem}">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource Good}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock FontSize="11.5" Foreground="{StaticResource Muted}"><Run Text="Optimal " /><Run Text="{Binding OptimalCount, Mode=OneWay}" Foreground="{StaticResource Text}" FontWeight="SemiBold" /></TextBlock>
                            </StackPanel>
                            <StackPanel Style="{StaticResource LegendItem}">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource Accent}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock FontSize="11.5" Foreground="{StaticResource Muted}"><Run Text="Recommended " /><Run Text="{Binding RecommendedCount, Mode=OneWay}" Foreground="{StaticResource Text}" FontWeight="SemiBold" /></TextBlock>
                            </StackPanel>
                            <StackPanel Style="{StaticResource LegendItem}">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource Warn}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock FontSize="11.5" Foreground="{StaticResource Muted}"><Run Text="Attention " /><Run Text="{Binding AttentionCount, Mode=OneWay}" Foreground="{StaticResource Text}" FontWeight="SemiBold" /></TextBlock>
                            </StackPanel>
                            <StackPanel Style="{StaticResource LegendItem}">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource Accent2}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock FontSize="11.5" Foreground="{StaticResource Muted}"><Run Text="Tips " /><Run Text="{Binding TipCount, Mode=OneWay}" Foreground="{StaticResource Text}" FontWeight="SemiBold" /></TextBlock>
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ============================== list -->
            <ItemsControl ItemsSource="{Binding Tweaks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardHoverable}" Margin="0,0,0,10" Padding="16,14">
                            <DockPanel>
                                <Grid DockPanel.Dock="Left" Width="42" Height="42" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <Border CornerRadius="12" Background="{Binding Status, Converter={StaticResource StatusSoft}}" />
                                    <TextBlock Text="{Binding Category, Converter={StaticResource CategoryGlyph}}" Style="{StaticResource Icon}" FontSize="16"
                                               Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" HorizontalAlignment="Center" />
                                </Grid>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                    <Button Content="Revert" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                                            Command="{Binding DataContext.RevertTweakCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                            Visibility="{Binding CanRevert, Converter={StaticResource BoolVis}}" />
                                    <Button Content="{Binding ActionLabel}" MinWidth="92"
                                            Command="{Binding DataContext.ApplyTweakCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                            Visibility="{Binding CanApply, Converter={StaticResource BoolVis}}" />
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <WrapPanel>
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource H3}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <Border Style="{StaticResource Chip}" Background="{Binding Status, Converter={StaticResource StatusSoft}}">
                                            <TextBlock Text="{Binding StatusLabel}" FontSize="10.5" FontWeight="SemiBold" Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                        </Border>
                                        <Border Style="{StaticResource Chip}" Background="#14FFFFFF">
                                            <TextBlock Text="{Binding Category}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
                                        </Border>
                                        <Border Style="{StaticResource Chip}" Background="#14FFFFFF">
                                            <TextBlock FontSize="10.5" FontWeight="SemiBold" Foreground="{Binding Impact, Converter={StaticResource ImpactBrush}}">
                                                <Run Text="{Binding Impact, Mode=OneWay}" /> impact
                                            </TextBlock>
                                        </Border>
                                        <Border Style="{StaticResource Chip}" Background="{StaticResource WarnSoft}" Visibility="{Binding RequiresAdmin, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="Admin" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Warn}" />
                                        </Border>
                                        <Border Style="{StaticResource Chip}" Background="{StaticResource WarnSoft}" Visibility="{Binding RequiresReboot, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="Restart" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Warn}" />
                                        </Border>
                                    </WrapPanel>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                                    <TextBlock Text="{Binding Result}" Foreground="{StaticResource Good}" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap"
                                               Visibility="{Binding Result, Converter={StaticResource BoolVis}}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>

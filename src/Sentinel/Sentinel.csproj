<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Sentinel</AssemblyName>
    <RootNamespace>Sentinel</RootNamespace>
    <Version>1.0.0</Version>
    <Product>Sentinel Game Optimizer</Product>
    <Title>Sentinel</Title>
    <Description>Detects your hardware and games, then tunes game settings to hit the FPS range you choose.</Description>
    <Authors>BenScriptsRBX</Authors>
    <Company>BenScriptsRBX</Company>
    <Copyright>Copyright (c) 2026 BenScriptsRBX. MIT License.</Copyright>
    <RepositoryUrl>https://github.com/BenScriptsRBX/Sentinel</RepositoryUrl>
    <PackageProjectUrl>https://github.com/BenScriptsRBX/Sentinel</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Sentinel.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\**\*.json" />
    <Resource Include="Assets\Sentinel.ico" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sentinel.Tests" />
  </ItemGroup>

</Project>
